{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.rivet.dev/rivet/v2/feature-plan.schema.json",
  "title": "Agilno governed feature plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "baselineCommit", "workRequestDigest", "client", "providerRefs", "nodes"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "baselineCommit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "workRequestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "client": { "enum": ["claude", "codex", "host"] },
    "clientProfile": { "$ref": "#/$defs/clientProfile" },
    "providerRefs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "nodes": { "type": "array", "minItems": 4, "maxItems": 128, "items": { "$ref": "#/$defs/node" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?![\\/])(?![A-Za-z]:)(?!.*[\\/]{2})(?!.*(?:^|[\\/])\\.\\.(?:[\\/]|$))(?!.*(?:^|[\\/])\\.(?:[\\/]|$))(?!.+[\\/]$)[^\\u0000\\r\\n]+$"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeMinutes", "tokenLimit", "costUsd", "taskLimit"],
      "properties": {
        "timeMinutes": { "type": "integer", "minimum": 1, "maximum": 10080 },
        "tokenLimit": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "costUsd": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 },
        "taskLimit": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "clientProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "provider", "model", "planning", "execution", "fallbackModel"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "id": { "const": "claude-bounded-sonnet-v1" },
        "provider": { "const": "claude" },
        "model": { "const": "sonnet" },
        "planning": {
          "type": "object",
          "additionalProperties": false,
          "required": ["effort", "timeoutMs", "maxCostUsd"],
          "properties": {
            "effort": { "const": "low" },
            "timeoutMs": { "const": 120000 },
            "maxCostUsd": { "const": 1 }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxCostUsd"],
          "properties": { "maxCostUsd": { "const": 2 } }
        },
        "fallbackModel": { "type": "null" }
      }
    },
    "evidenceType": { "enum": ["commit", "test", "journey", "screenshot", "report", "review", "human-approval", "external-update"] },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "roleId", "objective", "dependencies", "ownedPaths", "authorityScopes", "commandIds", "budget", "requiredEvidenceTypes", "acceptanceCriteria", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "parentId": { "$ref": "#/$defs/id" },
        "role": { "enum": ["boss", "manager", "worker"] },
        "roleId": { "$ref": "#/$defs/id" },
        "execution": {
          "type": "object", "additionalProperties": false, "required": ["client"],
          "properties": {
            "client": { "enum": ["claude", "codex"] },
            "clientProfile": { "$ref": "#/$defs/clientProfile" }
          }
        },
        "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "dependencies": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "ownedPaths": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
        "authorityScopes": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "commandIds": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "budget": { "$ref": "#/$defs/budget" },
        "requiredEvidenceTypes": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceType" } },
        "acceptanceCriteria": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
        "status": { "const": "proposed" },
        "approvalGate": { "enum": ["activation", "scope-change", "external-write", "visual-baseline", "merge", "deploy", "publication", "final-delivery"] }
      }
    }
  }
}
