{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.rivet.dev/rivet/v2/feature-decomposition.schema.json",
  "title": "Agilno bounded feature decomposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "workItems"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "agilno.feature-decomposition" },
    "workItems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/workItem" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?![\\/])(?![A-Za-z]:)(?!.*[\\/]{2})(?!.*(?:^|[\\/])\\.\\.(?:[\\/]|$))(?!.*(?:^|[\\/])\\.(?:[\\/]|$))(?!.+[\\/]$)[^\\u0000\\r\\n]+$"
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "ownedPaths", "acceptanceCriterionIndexes"],
      "properties": {
        "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "ownedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "acceptanceCriterionIndexes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 256 }
        }
      }
    }
  }
}
