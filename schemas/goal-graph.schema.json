{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.rivet.dev/rivet/v2/goal-graph.schema.json",
  "title": "Agilno runtime goal graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "goal", "providerRefs", "maxDelegationDepth", "status", "nodes"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "goal": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "providerRefs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "maxDelegationDepth": { "type": "integer", "minimum": 1, "maximum": 8 },
    "status": { "$ref": "#/$defs/status" },
    "nodes": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/node" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["proposed", "approved", "ready", "reserved", "running", "verifying", "corrective", "blocked", "failed", "completed", "archived", "cancelled"] },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeMinutes", "tokenLimit", "costUsd", "taskLimit"],
      "properties": {
        "timeMinutes": { "type": "integer", "minimum": 1, "maximum": 10080 },
        "tokenLimit": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "costUsd": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 },
        "taskLimit": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "id"],
      "properties": {
        "role": { "enum": ["boss", "manager", "worker"] },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "objective", "owner", "dependencies", "authorityScopes", "budget", "completionProfile", "requiredEvidenceTypes", "evidenceRefs", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "parentId": { "$ref": "#/$defs/id" },
        "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "owner": { "$ref": "#/$defs/owner" },
        "dependencies": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "authorityScopes": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "budget": { "$ref": "#/$defs/budget" },
        "completionProfile": { "$ref": "#/$defs/id" },
        "requiredEvidenceTypes": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceType" } },
        "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "status": { "$ref": "#/$defs/status" },
        "approvalGate": { "enum": ["activation", "scope-change", "external-write", "visual-baseline", "merge", "deploy", "publication", "final-delivery"] }
      }
    },
    "evidenceType": { "enum": ["commit", "test", "journey", "screenshot", "report", "review", "human-approval", "external-update"] }
  }
}
